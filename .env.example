# Both keys can be set; the UI lets you switch between them per request.

# Llama 4 Maverick (fast default) — get key at https://build.nvidia.com/
MAVERICK_API_KEY=nvapi-...

# Kimi K2.6 (richer creative / better spicy mode compliance)
KIMI_API_KEY=nvapi-...

# Optional overrides
# MAVERICK_BASE_URL=https://integrate.api.nvidia.com/v1
# KIMI_BASE_URL=https://integrate.api.nvidia.com/v1

# Fallback: if you only set one key, you can use this generic var instead
# LLM_API_KEY=nvapi-...

# Speed knobs (optional)
LLM_MAX_TOKENS=1000
# LLM_TEMPERATURE=0.9
# LLM_REASONING_EFFORT=none      # auto-applied for mistral
# LLM_EXTRA_PARAMS={"top_p":1}   # JSON-encoded extras

SITE_URL=http://localhost:3000
SITE_NAME=FlirtyAI
