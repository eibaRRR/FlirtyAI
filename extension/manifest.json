{
  "manifest_version": 3,
  "name": "FlirtyAI",
  "version": "0.1.0",
  "description": "Capture any chat on screen and get AI reply suggestions in your chosen vibe.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlirtyAI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
